{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xlgmokha/scim-kit/schemas/scim.json",
  "title": "SCIM 2.0 documents (RFC 7643, RFC 7644)",
  "$defs": {
    "meta": {
      "title": "RFC 7643 3.1 common meta attribute",
      "type": "object",
      "properties": {
        "resourceType": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "lastModified": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "version": {
          "$comment": "RFC 7232 2.3 entity-tag, weak ones prefixed W/",
          "type": "string",
          "pattern": "^(W/)?\"[!#-~]*\"$"
        }
      }
    },
    "supported": {
      "type": "object",
      "properties": { "supported": { "type": "boolean" } },
      "required": ["supported"]
    },
    "authenticationScheme": {
      "title": "RFC 7643 5 authentication scheme",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "specUri": { "type": "string" },
        "documentationUri": { "type": "string" },
        "primary": { "type": "boolean" }
      },
      "required": ["type", "name", "description"]
    },
    "attribute": {
      "title": "RFC 7643 7 attribute definition",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "string", "boolean", "decimal", "integer", "dateTime",
            "reference", "binary", "complex"
          ]
        },
        "multiValued": { "type": "boolean" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "canonicalValues": { "type": "array" },
        "caseExact": { "type": "boolean" },
        "mutability": {
          "type": "string",
          "enum": ["readOnly", "readWrite", "immutable", "writeOnly"]
        },
        "returned": {
          "type": "string",
          "enum": ["always", "never", "default", "request"]
        },
        "uniqueness": {
          "type": "string",
          "enum": ["none", "server", "global"]
        },
        "referenceTypes": { "type": "array", "items": { "type": "string" } },
        "subAttributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute" }
        }
      },
      "required": ["name", "type"]
    },
    "listResponse": {
      "title": "RFC 7644 3.4.2 ListResponse",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array", "items": { "type": "string" },
          "contains": {
            "const": "urn:ietf:params:scim:api:messages:2.0:ListResponse"
          }
        },
        "totalResults": { "type": "integer" },
        "itemsPerPage": { "type": "integer" },
        "startIndex": { "type": "integer" },
        "Resources": { "type": "array", "items": {} }
      },
      "required": ["schemas", "totalResults"]
    },
    "error": {
      "title": "RFC 7644 3.12 Error",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array", "items": { "type": "string" },
          "contains": {
            "const": "urn:ietf:params:scim:api:messages:2.0:Error"
          }
        },
        "status": { "type": "string" },
        "scimType": {
          "type": "string",
          "enum": [
            "invalidFilter", "tooMany", "uniqueness", "mutability",
            "invalidSyntax", "invalidPath", "noTarget", "invalidValue",
            "invalidVers", "sensitive"
          ]
        },
        "detail": { "type": "string" }
      },
      "required": ["schemas", "status"]
    },
    "serviceProviderConfig": {
      "title": "RFC 7643 5 ServiceProviderConfig",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array", "items": { "type": "string" },
          "contains": {
            "const": "urn:ietf:params:scim:schemas:core:2.0:ServiceProviderConfig"
          }
        },
        "id": { "type": "string" },
        "externalId": { "type": "string" },
        "documentationUri": { "type": "string" },
        "patch": { "$ref": "#/$defs/supported" },
        "changePassword": { "$ref": "#/$defs/supported" },
        "sort": { "$ref": "#/$defs/supported" },
        "etag": { "$ref": "#/$defs/supported" },
        "bulk": {
          "allOf": [{ "$ref": "#/$defs/supported" }],
          "properties": {
            "maxOperations": { "type": "integer" },
            "maxPayloadSize": { "type": "integer" }
          },
          "required": ["maxOperations", "maxPayloadSize"]
        },
        "filter": {
          "allOf": [{ "$ref": "#/$defs/supported" }],
          "properties": { "maxResults": { "type": "integer" } },
          "required": ["maxResults"]
        },
        "authenticationSchemes": {
          "type": "array",
          "items": { "$ref": "#/$defs/authenticationScheme" }
        },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "required": [
        "schemas", "patch", "bulk", "filter", "changePassword", "sort",
        "etag", "authenticationSchemes"
      ]
    },
    "schema": {
      "title": "RFC 7643 7 Schema resource",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array", "items": { "type": "string" },
          "contains": {
            "const": "urn:ietf:params:scim:schemas:core:2.0:Schema"
          }
        },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "attributes": {
          "type": "array", "items": { "$ref": "#/$defs/attribute" }
        },
        "externalId": { "type": "string" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "required": ["schemas", "id", "attributes"]
    },
    "resourceType": {
      "title": "RFC 7643 6 ResourceType resource",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "array", "items": { "type": "string" },
          "contains": {
            "const": "urn:ietf:params:scim:schemas:core:2.0:ResourceType"
          }
        },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "endpoint": { "type": "string" },
        "schema": { "type": "string" },
        "schemaExtensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "required": ["schema", "required"]
          }
        },
        "externalId": { "type": "string" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "required": ["schemas", "name", "endpoint", "schema"]
    },
    "schemaList": {
      "title": "RFC 7644 4 /Schemas response",
      "allOf": [
        { "$ref": "#/$defs/listResponse" },
        {
          "properties": {
            "Resources": { "items": { "$ref": "#/$defs/schema" } }
          },
          "required": ["Resources"]
        }
      ]
    },
    "resourceTypeList": {
      "title": "RFC 7644 4 /ResourceTypes response",
      "allOf": [
        { "$ref": "#/$defs/listResponse" },
        {
          "properties": {
            "Resources": { "items": { "$ref": "#/$defs/resourceType" } }
          },
          "required": ["Resources"]
        }
      ]
    }
  }
}
